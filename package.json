  "private": true,
  "scripts": {
    "prebuild": "bash ./devops/bin/compile-ts.sh && bun run devops/bin/build-locales.ts && bash ./devops/bin/copy-hls-worker.sh",
    "build": "NODE_ENV=production next build",
    "db-migrate": "drizzle-kit migrate",
    "build-locales": "bun run devops/bin/build-locales.ts",
    "help": "fish -c 'help'",
    "preinstall": "node -e '!process.env.npm_config_user_agent.startsWith(\"pnpm/\")&&!console.log(\"Use `pnpm install` to install dependencies in this repository\\n\")&&process.exit(1)'",
    "vercel-build": "bash ./devops/bin/vercel-build.sh",
    "typegen": "dotenv -- cross-var \"NEXT_PUBLIC_DATOCMS_ENVIRONMENT=%NEXT_PUBLIC_DATOCMS_ENVIRONMENT% graphql-codegen --config graphql.config.mjs --project dato_schema && NEXT_PUBLIC_DATOCMS_ENVIRONMENT=%NEXT_PUBLIC_DATOCMS_ENVIRONMENT% graphql-codegen --config graphql.config.mjs --project dato_sdk\"",
    "sync-typesense:supercars": "bun run src/server/typesense/scripts/sync-supercars.ts",
    "sync-typesense:tracks": "bun run src/server/typesense/scripts/sync-tracks.ts",
    "sync-typesense:pages": "bun run src/server/typesense/scripts/sync-pages.ts",
    "sync-typesense:new": "bun run src/server/typesense/scripts/sync-supercars.ts && bun run src/server/typesense/scripts/sync-tracks.ts && bun run src/server/typesense/scripts/sync-pages.ts",
    "sync-typesense:all": "LOOKBACK_IN_MINUTES=0 bun run src/server/typesense/scripts/sync-supercars.ts && LOOKBACK_IN_MINUTES=0 bun run src/server/typesense/scripts/sync-tracks.ts && LOOKBACK_IN_MINUTES=0 bun run src/server/typesense/scripts/sync-pages.ts",
    "sync-rocket-rez:events": "bun run src/server/rocket-rez/scripts/sync-events-cache.ts",
    "sync-rocket-rez:event": "bun run src/server/rocket-rez/scripts/sync-events-cache.ts",
    "sync-rocket-rez:schedules": "bun run src/server/rocket-rez/scripts/sync-events-schedules.ts",
    "sync-rocket-rez:products": "bun run src/server/rocket-rez/scripts/sync-products-cache.ts",
    "convert-fonts": "for f in public/fonts/*.ttf; do cat \"$f\" | pnpm exec ttf2woff2 > \"${f%.ttf}.woff2\"; done"
  }
}
