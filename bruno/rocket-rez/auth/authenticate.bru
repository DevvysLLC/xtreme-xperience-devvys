meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{ROCKET_REZ_API_BASE_URL}}/v1/oauth2/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "client_id": "{{ROCKET_REZ_CLIENT_ID}}",
    "client_secret": "{{ROCKET_REZ_CLIENT_SECRET}}",
    "scope": "{{ROCKET_REZ_API_SCOPES}}",
    "grant_type": "client_credentials"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body?.data?.access_token;
  
  if (token) {
    bru.setVar("jwt", token);
    if (typeof bru.setEnvVar === "function") bru.setEnvVar("jwt", token);
    if (typeof bru.setGlobalVar === "function") bru.setGlobalVar("jwt", token);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('access_token');
  });
  
  test("Response has token_type", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('token_type');
  });
  
  test("Response has expires_in", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('expiry');
  });
}
