meta {
  name: Remove All Line Items
  type: http
  seq: 8
}

delete {
  url: {{ROCKET_REZ_API_BASE_URL}}/v1/headless/cart/lineitems
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cartToken}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has cart data", function() {
    expect(res.getBody()).to.have.property('data');
  });
}
