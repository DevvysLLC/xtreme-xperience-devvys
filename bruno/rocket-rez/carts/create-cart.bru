meta {
  name: Create Cart
  type: http
  seq: 2
}

post {
  url: {{ROCKET_REZ_API_BASE_URL}}/v1/headless/cart
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "lineItems": [
      {
        "id": 3,
        "quantity": 1,
        "type": "giftcard"
      }
    ]
  }
}

script:post-response {
  bru.setVar("cartToken", res.getBody().data.cartToken);
  bru.setVar("cartId", res.getBody().data.cart.id);
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has cart data", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('cartToken');
  });
}
