meta {
  name: XXRR call example cart 2 - sonoma - lamborghini
  type: http
  seq: 10
}

post {
  url: {{ROCKET_REZ_API_BASE_URL}}/v1/headless/cart/lineitems
  body: json
  auth: bearer
}

auth:bearer {
  token: {{cartToken}}
}

body:json {
  {
      "lineItems": [
          {
              "id": 513,
              "type": "Event",
              "quantity": 2,
              "scheduleId": 266406,
              "rateId": 3,
              "rateType": "Participant"
          },
          {
              "id": 55,
              "type": "Retail",
              "quantity": 1
          }
      ]
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has cart data", function() {
    expect(res.getBody()).to.have.property('data');
  });
}
