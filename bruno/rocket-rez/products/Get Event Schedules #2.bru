meta {
  name: Get Event Schedules #2
  type: http
  seq: 7
}

get {
  url: {{ROCKET_REZ_API_BASE_URL}}/v1/headless/products/event/513/schedules?startDate=2026-08-05&endDate=2026-08-07
  body: none
  auth: bearer
}

query {
  startDate: 2026-08-05
  endDate: 2026-08-07
}

auth:bearer {
  token: {{jwt}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has schedules array", function() {
    expect(res.getBody()).to.have.property('schedules');
    expect(res.getBody().schedules).to.be.an('array');
  });
  
  test("Response has pagination info", function() {
    expect(res.getBody()).to.have.property('pageSize');
    expect(res.getBody()).to.have.property('pageIndex');
    expect(res.getBody()).to.have.property('totalCount');
  });
}
