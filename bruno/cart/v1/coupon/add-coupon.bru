meta {
  name: Add Coupon
  type: http
  seq: 7
}

post {
  url: {{API_BASE_URL}}/api/v1/booking/cart/coupon/add
  body: json
  auth: none
}

headers {
  X-Middleware-Auth-Token: {{MIDDLEWARE_AUTH_TOKEN}}
}

body:json {
  {
    "code": "DISCOUNT10"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has success status", function() {
    expect(res.getBody()).to.have.property('status');
    expect(res.getBody().status).to.equal('success');
  });

  test("Response has data with cart", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('id');
    expect(res.getBody().data).to.have.property('status');
    expect(res.getBody().data).to.have.property('lineItems');
    expect(res.getBody().data.lineItems).to.be.an('array');
  });
}
