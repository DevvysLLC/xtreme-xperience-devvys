meta {
  name: Get Events
  type: http
  seq: 1
}

get {
  url: {{API_BASE_URL}}/api/v1/booking/events
  body: none
  auth: none
}

headers {
  X-Middleware-Auth-Token: {{MIDDLEWARE_AUTH_TOKEN}}
}

query {
  pageSize: 10
  pageIndex: 0
  startDate:
  endDate:
  name:
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has success status", function() {
    expect(res.getBody()).to.have.property('status');
    expect(res.getBody().status).to.equal('success');
  });

  test("Response has data with events", function() {
    expect(res.getBody()).to.have.property('data');
    expect(res.getBody().data).to.have.property('events');
    expect(res.getBody().data.events).to.be.an('array');
  });

  test("Response has pagination info", function() {
    expect(res.getBody().data).to.have.property('pagination');
  });
}
