meta {
  name: Get Booking Config
  type: http
  seq: 1
}

get {
  url: {{API_BASE_URL}}/api/v1/booking/config
  body: none
  auth: none
}

headers {
  X-Middleware-Auth-Token: {{MIDDLEWARE_AUTH_TOKEN}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has success status", function() {
    expect(res.getBody()).to.have.property('status');
    expect(res.getBody().status).to.equal('success');
  });

  test("Response has data with booking config", function() {
    expect(res.getBody()).to.have.property('data');
  });

  test("Config has pages array", function() {
    expect(res.getBody().data).to.have.property('pages');
    expect(res.getBody().data.pages).to.be.an('array');
  });

  test("Config has supercars array", function() {
    expect(res.getBody().data).to.have.property('supercars');
    expect(res.getBody().data.supercars).to.be.an('array');
  });
}
