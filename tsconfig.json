{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "node",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "types": [],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next/types/**/*.ts",
    "devops/src/**/*",
    "drizzle.config.ts",
    "eslint-strict.config.mjs",
    "eslint.config.mjs",
    "next.config.ts",
    "src/**/*"
  ],
  "exclude": [
    ".test-build",
    ".next",
    "dist",
    "node_modules",
    "rspack.config.cjs"
  ]
}
